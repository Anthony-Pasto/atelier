<!DOCTYPE html>
<html lang="fr"><head><%- include('../partials/head') %></head><body>
<%- include('../partials/header') %>
<main><h2>Contacts</h2>
<% if (typeof confirmation !== 'undefined') { %><p role="status"><%= confirmation %></p><% } %>
<form action="/contacts" method="POST">
<div><label for="nom">Nom</label><input type="text" id="nom" name="nom" required></div>
<div><label for="email">Courriel</label><input type="email" id="email" name="email" required></div>
<div><label for="message">Message</label><textarea id="message" name="message" required></textarea></div>
<button type="submit">Envoyer</button>
</form></main>
<%- include('../partials/footer') %>
</body></html>
